"""
BUILD.bazel for @tummycrypt/scheduling-kit.

Bazel is the only distribution path (RU6). The pnpm scripts stay as local
conveniences; Bazel owns the hermetic graph and is the proof authority.

  Package:    bazel build //:pkg                (svelte-package dist/ + package.json)
  Tests:      bazel test //:test //:test-component
  Typecheck:  bazel test //:typecheck           (svelte-check --tsgo on TypeScript 7.0.2,
                                                 plus a seeded-error canary)

In-house modules (tinyland-calendar, tinyland-caldav-client) are linked from
their bazel_dep //:pkg targets; package.json carries no in-house specifiers.
"""

load("@aspect_bazel_lib//lib:copy_to_directory.bzl", "copy_to_directory")
load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_library", "js_run_binary", "js_test")
load("@aspect_rules_js//npm:defs.bzl", "npm_link_package", "npm_package")
load("@tummycrypt_scheduling_kit_npm//:defs.bzl", "npm_link_all_packages")
load("@tummycrypt_scheduling_kit_npm//:vitest/package_json.bzl", vitest_bin = "bin")

# =============================================================================
# npm link - makes node_modules available
# =============================================================================

npm_link_all_packages(name = "node_modules")

# First-party modules resolved through the Bazel module graph (RU6). The
# ./recurrence and ./caldav subpaths import them lazily; they are linked here
# for the declaration build, the type check and the tests. A consumer that
# uses those subpaths links the same modules next to this package.
npm_link_package(
    name = "node_modules/@tummycrypt/tinyland-calendar",
    src = "@tummycrypt_tinyland_calendar//:pkg",
)

npm_link_package(
    name = "node_modules/@tummycrypt/tinyland-caldav-client",
    src = "@tummycrypt_tinyland_caldav_client//:pkg",
)

INHOUSE_NPM_PACKAGES = [
    ":node_modules/@tummycrypt/tinyland-caldav-client",
    ":node_modules/@tummycrypt/tinyland-calendar",
]

js_binary(
    name = "bazel_svelte_package",
    data = [
        ":node_modules/@sveltejs/package",
        ":node_modules/@sveltejs/vite-plugin-svelte",
        ":node_modules/svelte",
        ":node_modules/typescript",
    ],
    entry_point = "scripts/svelte-package-bazel-wrapper.mjs",
)

# =============================================================================
# Svelte package build
#
# svelte-package compiles src/ to dist/: .svelte components, .svelte.ts
# stores and plain .ts files in one pass. Its TypeScript transpile and the
# svelte2tsx declaration emit run in-process on the RU13b companion
# (.pnpmfile.cjs); there is no SvelteKit sync step.
# =============================================================================

SCHEDULING_KIT_PACKAGE_SOURCES = glob(
    [
        "src/**/*.ts",
        "src/**/*.svelte",
        "src/**/*.svelte.ts",
    ],
    exclude = [
        "src/**/*.test.ts",
        "src/**/*.spec.ts",
        "src/tests/**",
    ],
)

copy_to_directory(
    name = "scheduling_kit_src",
    srcs = SCHEDULING_KIT_PACKAGE_SOURCES,
    out = "scheduling_kit_src",
    root_paths = ["src"],
)

js_run_binary(
    name = "scheduling_kit_build",
    srcs = [
        "package.json",
        "svelte.config.js",
        "tsconfig.json",
        ":node_modules",
        ":scheduling_kit_src",
    ] + INHOUSE_NPM_PACKAGES,
    args = [
        "-i",
        "$(execpath :scheduling_kit_src)",
        "-o",
        "dist",
    ],
    out_dirs = ["dist"],
    tool = ":bazel_svelte_package",
    visibility = ["//visibility:public"],
)

js_library(
    name = "scheduling_kit",
    srcs = [":scheduling_kit_build"],
    # Runtime dependencies (package.json "dependencies") that consumers do not
    # provide themselves. Declaring them here carries their npm package store
    # infos through //:pkg so Bazel consumers that link this module via
    # npm_link_package (e.g. scheduling-bridge) get the dep store entries
    # linked next to the package.
    #
    # `effect` is intentionally NOT linked: consumers declare their own copy
    # and effect values cross the package boundary (e.g. re-exported Errors),
    # so a second linked copy would fork runtime identity (instanceof) and
    # break consumer declaration emit (TS2742) with duplicate type roots.
    # Peer dependencies and the lazily loaded in-house modules are likewise
    # excluded; consumers provide them.
    deps = [
        ":node_modules/drizzle-orm",
        ":node_modules/zod",
    ],
    visibility = ["//visibility:public"],
)

# =============================================================================
# JavaScript package artifact
# =============================================================================

npm_package(
    name = "pkg",
    srcs = [
        "CHANGELOG.md",
        "LICENSE",
        "README.md",
        "package.json",
        ":scheduling_kit",
    ],
    package = "@tummycrypt/scheduling-kit",
    version = "1.0.0",
    visibility = ["//visibility:public"],
)

# =============================================================================
# Test targets
# =============================================================================

vitest_bin.vitest_test(
    name = "test",
    args = [
        "run",
        "--reporter=verbose",
        "--config",
        "$(rootpath vitest.config.ts)",
    ],
    data = [
        "package.json",
        "svelte.config.js",
        "tsconfig.json",
        "vitest.config.ts",
        ":node_modules",
        ":node_modules/vitest",
    ] + INHOUSE_NPM_PACKAGES + glob([
        "src/**/*.ts",
        "src/**/*.svelte",
        "src/**/*.svelte.ts",
        "src/**/*.json",
    ]),
    log_level = "info",
    visibility = ["//visibility:public"],
)

# The rendered-component suite exercises the actual Svelte callbacks.
# Keep it graph-addressable; script-only component results are not Bazel proof.
vitest_bin.vitest_test(
    name = "test-component",
    args = [
        "run",
        "--reporter=verbose",
        "--config",
        "$(rootpath vitest.component.config.ts)",
    ],
    data = [
        "package.json",
        "svelte.config.js",
        "tsconfig.json",
        "vitest.component.config.ts",
        ":node_modules",
    ] + INHOUSE_NPM_PACKAGES + glob([
        "src/**/*.ts",
        "src/**/*.svelte",
        "src/**/*.json",
        "tests/e2e/**/*.ts",
    ]),
    log_level = "info",
    visibility = ["//visibility:public"],
)

# =============================================================================
# Typecheck (RU13: svelte-check --tsgo on TypeScript 7.0.2)
#
# svelte-check runs in its TypeScript 7 native mode, so TypeScript 7.0.2 checks
# every .svelte and .ts file tsconfig.json includes. --tsgo writes its emit
# directory, so the runner checks a writable scratch copy of this declared tree.
# =============================================================================

copy_to_directory(
    name = "check_workspace",
    srcs = [
        "package.json",
        "svelte.config.js",
        "tsconfig.json",
    ] + glob(
        [
            "src/**/*.ts",
            "src/**/*.svelte",
            "src/**/*.svelte.ts",
            "src/**/*.json",
        ],
    ),
    hardlink = "off",
    root_paths = ["."],
)

TYPECHECK_DATA = [
    ":check_workspace",
    ":node_modules",
] + INHOUSE_NPM_PACKAGES

js_test(
    name = "svelte_check_test",
    args = [
        "--workspace",
        "$(rootpath :check_workspace)",
    ],
    data = TYPECHECK_DATA,
    entry_point = "scripts/bazel/run-svelte-check.mjs",
    timeout = "moderate",
)

# Seeded-error canary for the gate above: a .ts and a .svelte type error are
# written into the scratch copy and the test fails unless svelte-check --tsgo
# reports both. Under --tsgo a tsconfig that checks nothing reports 0 errors
# (sveltejs/language-tools#3136).
js_test(
    name = "svelte_check_canary_test",
    args = [
        "--workspace",
        "$(rootpath :check_workspace)",
        "--canary",
    ],
    data = TYPECHECK_DATA,
    entry_point = "scripts/bazel/run-svelte-check.mjs",
    timeout = "moderate",
)

test_suite(
    name = "typecheck",
    tests = [
        ":svelte_check_canary_test",
        ":svelte_check_test",
    ],
)

# =============================================================================
# Exported files
# =============================================================================

exports_files(
    [
        ".npmrc",
        "package.json",
        "svelte.config.js",
        "tsconfig.json",
        "vitest.config.ts",
    ],
    visibility = ["//visibility:public"],
)
